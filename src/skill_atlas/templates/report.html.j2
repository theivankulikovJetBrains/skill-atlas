<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Skill Atlas — {{ result.source }}</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --surface: #f7f7f8;
    --border: #e3e3e6;
    --text: #1a1a1c;
    --muted: #6b6b73;
    --accent: #3b5bdb;
    --warn-bg: #fff4e5;
    --warn-text: #8a4b00;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #17171a;
      --surface: #1f1f23;
      --border: #33333a;
      --text: #ececee;
      --muted: #9b9ba3;
      --accent: #8da2fb;
      --warn-bg: #3a2a10;
      --warn-text: #f0b866;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 2.5rem 1.5rem 4rem;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  main { max-width: 68rem; margin: 0 auto; }
  h1 { margin: 0 0 .35rem; font-size: 1.5rem; letter-spacing: -.01em; }
  .source { margin: 0; color: var(--muted); font-size: .95rem; word-break: break-all; }
  .source a { color: var(--accent); }
  .meta {
    display: flex; flex-wrap: wrap; gap: .5rem 1.5rem;
    margin: 1.25rem 0 2rem; padding: .85rem 1.1rem;
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
    font-size: .85rem; color: var(--muted);
  }
  .meta b { color: var(--text); font-weight: 600; }
  code, .mono {
    font-family: ui-monospace, SFMono-Regular, "Cascadia Mono", Consolas, monospace;
    font-size: .855em;
  }
  table { width: 100%; border-collapse: collapse; }
  caption { text-align: left; font-size: .8rem; color: var(--muted); padding-bottom: .5rem; }
  th, td { text-align: left; padding: .8rem .75rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; }
  tbody tr:hover { background: var(--surface); }
  td.name { font-weight: 600; white-space: nowrap; }
  td.path { max-width: 22rem; }
  td.path a { color: var(--accent); text-decoration: none; word-break: break-all; }
  td.path a:hover { text-decoration: underline; }
  td.desc { color: var(--text); }
  td.desc .none { color: var(--muted); font-style: italic; }
  .issue {
    display: block; margin-top: .4rem; padding: .2rem .5rem; border-radius: 5px;
    background: var(--warn-bg); color: var(--warn-text); font-size: .78rem; width: fit-content;
  }
  .empty {
    padding: 2.5rem 1.25rem; text-align: center; color: var(--muted);
    background: var(--surface); border: 1px dashed var(--border); border-radius: 8px;
  }
  footer { margin-top: 2.5rem; font-size: .78rem; color: var(--muted); }
</style>
</head>
<body>
<main>
  <h1>Skill Atlas</h1>
  <p class="source">
    {% if result.web_base_url %}
      <a href="{{ result.web_base_url }}">{{ result.source }}</a>
    {% else %}
      {{ result.source }}
    {% endif %}
  </p>

  <div class="meta">
    <span>Skills found <b>{{ result.skill_count }}</b></span>
    {% if result.ref %}
      <span>Ref <b class="mono">{{ result.ref }}</b></span>
    {% endif %}
    {% if result.commit %}
      <span>Commit <b class="mono">{{ result.commit[:12] }}</b></span>
    {% endif %}
    <span>Scanned <b>{{ result.scanned_at }}</b></span>
  </div>

  {% if result.skills %}
    <table>
      <caption>Every SKILL.md found in the repository, ordered by path.</caption>
      <thead>
        <tr><th scope="col">Name</th><th scope="col">File</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        {% for skill in result.skills %}
          {% set url = result.web_url_for(skill) %}
          <tr>
            <td class="name">{{ skill.name }}</td>
            <td class="path mono">
              {% if url %}
                <a href="{{ url }}">{{ skill.path }}</a>
              {% else %}
                {{ skill.path }}
              {% endif %}
            </td>
            <td class="desc">
              {% if skill.description %}
                {{ skill.description }}
              {% else %}
                <span class="none">No description</span>
              {% endif %}
              {% for issue in skill.issues %}
                <span class="issue">{{ skill.path.rsplit('/', 1)[-1] }} {{ issue }}</span>
              {% endfor %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="empty">No skills found. Skill Atlas looks for <code>SKILL.md</code> files with YAML frontmatter.</p>
  {% endif %}

  <footer>Generated by skill-atlas {{ version }}.</footer>
</main>
</body>
</html>
